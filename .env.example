# Local application database
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/job_tracker

# Local test database
TEST_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/job_tracker_test

# JWT authentication
JWT_SECRET_KEY=your-secret-key-here

# Docker PostgreSQL configuration
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=your-docker-password-here